# ----------------------------------------------------------------------------
# FlowSuite — root environment file consumed by docker-compose.yml
# Copy to `.env` and adjust. NEVER commit the real .env.
# ----------------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_DB=flowsuite
POSTGRES_USER=flowsuite
POSTGRES_PASSWORD=flowsuite_dev_password
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- API (Spring Boot) ---
API_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# --- Web (React/nginx) ---
WEB_PORT=5173

# Datasource (points at the compose service names)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/flowsuite
SPRING_DATASOURCE_USERNAME=flowsuite
SPRING_DATASOURCE_PASSWORD=flowsuite_dev_password
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# --- JWT (generate strong secrets for anything beyond local dev) ---
JWT_SECRET=change-me-to-a-long-random-base64-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30

# --- Stripe (Test Mode) — wired in Phase 3 ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=http://localhost:5173/billing/success
STRIPE_CANCEL_URL=http://localhost:5173/billing/cancel

# --- Email ---
# App-level settings (always used to build links / sender identity):
MAIL_ENABLED=true
MAIL_FROM_ADDRESS=no-reply@flowsuite.local
MAIL_FROM_NAME=FlowSuite
APP_BASE_URL=http://localhost:5173
# SMTP transport (Spring Boot relaxed binding). Leave SPRING_MAIL_HOST unset to disable
# real delivery — reset/invite links are then logged by the API instead of emailed.
#SPRING_MAIL_HOST=smtp.example.com
#SPRING_MAIL_PORT=587
#SPRING_MAIL_USERNAME=apikey
#SPRING_MAIL_PASSWORD=your_smtp_password
#SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
#SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
